digraph G {
graph [rankdir=TB, bgcolor="#fcfbf7", nodesep=0.5, ranksep=0.7, pad=0.35, fontname="Microsoft YaHei"];
node [shape=plain, fontname="Microsoft YaHei"];
edge [fontname="Microsoft YaHei", fontsize=11, color="#678374"];
label="E05 命令与数据控制：物理表关系
各表均含所属用户；箭头由外键指向目标键，可空与唯一性见字典"; labelloc=t; fontsize=19;
command_receipts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>持久提交回执</B></TD></TR><TR><TD ALIGN="LEFT">操作标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">规范化请求摘要</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">唯一提交标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">来源任务标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">提交授权修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">提交数据修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">结果标识与版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">操作令牌签发时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">回执过期时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
audit_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>最小化业务事件</B></TD></TR><TR><TD ALIGN="LEFT">事件标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">提交标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">事件类型</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">对象类型</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">对象修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">原因编码</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
data_control_jobs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>导出删除清理任务</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">处理类型</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">处理进度</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">范围与断点</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">请求时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">目标截止</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">完成时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">临时导出文件键</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">导出文件过期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">失败原因编码</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
audit_events -> command_receipts [label="引用", arrowhead=vee];
}