digraph G {
graph [rankdir=TB, bgcolor="#fcfbf7", nodesep=0.5, ranksep=0.7, pad=0.35, fontname="Microsoft YaHei"];
node [shape=plain, fontname="Microsoft YaHei"];
edge [fontname="Microsoft YaHei", fontsize=11, color="#678374"];
label="E01 授权与证据：物理表关系
各表均含所属用户；箭头由外键指向目标键，可空与唯一性见字典"; labelloc=t; fontsize=19;
user_control [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>用户处理控制</B></TD></TR><TR><TD ALIGN="LEFT">托管身份主体</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">处理状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">授权修订标记</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户数据修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">当前档案修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">主动删除请求时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
profile_revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>档案确认版本</B></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">已确认字段</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
media_assets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>临时图片</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">本机受控文件键</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">材料用途</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">内容摘要</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">图片过期时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">图片处理状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
consent_revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>用途授权修订</B></TD></TR><TR><TD ALIGN="LEFT">用途</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">范围键</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">外传图片标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">允许使用</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">接收方</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">授权修订标记</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
task_sessions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>临时任务会话</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">任务类型</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">任务状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">草稿修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">未确认草稿</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">绑定授权修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">任务过期时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
context_snapshots [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>已确认情境</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">档案修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">情境指纹</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">已确认情境内容</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">当时授权修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
source_references [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>证据来源</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">来源类型</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">出处或自述说明</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">商品或菜单规格</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">材料时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">取得时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">原图片标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">材料摘要</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">核对依据</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
food_observations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>食品证据版本</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">上一证据版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">食品名称</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">当前规格</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">配方覆盖</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">核对时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">营养基准量状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">营养基准量定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">营养基准量单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
food_fields [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>食品逐字段事实</B></TD></TR><TR><TD ALIGN="LEFT">食品证据标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">字段键</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">字段状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">值类型</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">数值定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">文字值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">字段单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">原始候选值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">核对时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
field_sources [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>字段来源关联</B></TD></TR><TR><TD ALIGN="LEFT">食品证据标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">字段键</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">来源标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">来源角色</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
constraint_assessments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>约束评估</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">情境标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">食品证据标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">规则版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">评估结论</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">原因与受影响操作</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">评估时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
