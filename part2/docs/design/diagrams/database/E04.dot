digraph G {
graph [rankdir=TB, bgcolor="#fcfbf7", nodesep=0.5, ranksep=0.7, pad=0.35, fontname="Microsoft YaHei"];
node [shape=plain, fontname="Microsoft YaHei"];
edge [fontname="Microsoft YaHei", fontsize=11, color="#678374"];
label="E04 行动与学习：物理表关系
