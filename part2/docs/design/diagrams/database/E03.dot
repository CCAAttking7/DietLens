digraph G {
graph [rankdir=TB, bgcolor="#fcfbf7", nodesep=0.5, ranksep=0.7, pad=0.35, fontname="Microsoft YaHei"];
node [shape=plain, fontname="Microsoft YaHei"];
edge [fontname="Microsoft YaHei", fontsize=11, color="#678374"];
label="E03 实际与回顾：物理表关系
各表均含所属用户；箭头由外键指向目标键，可空与唯一性见字典"; labelloc=t; fontsize=19;
meal_heads [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>个人用餐身份</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">当前餐食修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">并发版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">身份状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
meal_revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>个人用餐版本</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">业务用餐日期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">规范餐次</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">实际时点</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">用户自述</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
reported_foods [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>个人实际食物</B></TD></TR><TR><TD ALIGN="LEFT">用餐身份</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">用餐修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">条目标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">实际食物名称</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">食品证据标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">计划食物出处</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">录入来源</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">个人实际份量状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">个人实际份量定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">个人实际份量单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
expected_schedules [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>预期餐次版本</B></TD></TR><TR><TD ALIGN="LEFT">自然周起始</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
expected_slots [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>预期餐次槽位</B></TD></TR><TR><TD ALIGN="LEFT">自然周起始</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">预期餐次修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">餐次日期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">规范餐次</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR></TABLE>>];
recovery_episodes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>恢复周期确认</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">并发版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">确认偏离起点</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">确认回归终点</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认情境</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
recovery_exclusions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>恢复排除时段</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">恢复周期标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">排除开始</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">排除结束</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">排除原因</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
week_presentations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>连续周呈现修订</B></TD></TR><TR><TD ALIGN="LEFT">自然周起始</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">呈现决定</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认依据</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
meal_heads -> meal_revisions [label="当前版本引用", arrowhead=vee];
meal_revisions -> meal_heads [label="引用", arrowhead=vee];
reported_foods -> meal_revisions [label="引用", arrowhead=vee];
expected_slots -> expected_schedules [label="引用", arrowhead=vee];
recovery_exclusions -> recovery_episodes [label="引用", arrowhead=vee];
}