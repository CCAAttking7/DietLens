digraph G {
graph [rankdir=TB, bgcolor="#fcfbf7", nodesep=0.5, ranksep=0.7, pad=0.35, fontname="Microsoft YaHei"];
node [shape=plain, fontname="Microsoft YaHei"];
edge [fontname="Microsoft YaHei", fontsize=11, color="#678374"];
label="E02 计划与准备：物理表关系
各表均含所属用户；箭头由外键指向目标键，可空与唯一性见字典"; labelloc=t; fontsize=19;
ingredients [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>标准食材</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">标准名称</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">外部编码</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
plan_heads [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>计划身份</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">当前确认修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">并发版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">身份状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
plan_revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>计划确认版本</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">计划模式</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">开始日期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">结束日期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">计划天数</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">情境标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
planned_meals [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>计划餐次</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">计划标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">计划修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">餐次日期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">规范餐次</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">准备人数</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
planned_foods [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>计划食物</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">计划餐次标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">食物名称</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">食品证据标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">约束评估标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">数量基准</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">计划份量状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">计划份量定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">计划份量单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
ingredient_requirements [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>食材需求</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">计划食物标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">食材标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">数量基准</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">配方来源</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">食材用量状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">食材用量定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">食材用量单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
slot_assignments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>当前槽位归属</B></TD></TR><TR><TD ALIGN="LEFT">餐次日期</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">规范餐次</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">当前计划餐次标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">槽位并发版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
inventory_heads [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>库存身份</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">标准食材标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">核对口径单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">当前库存修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">并发版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">身份状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
inventory_revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>库存核对版本</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">修订号</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">库存量状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">库存定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">库存核对时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">变更原因</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
preparation_lists [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>准备采购清单</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">来源计划标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">来源计划修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">并发版本</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">清单状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">库存核对截点</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">用户确认时间</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR></TABLE>>];
preparation_lines [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>清单条目</B></TD></TR><TR><TD ALIGN="LEFT">对象标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 </FONT></TD></TR><TR><TD ALIGN="LEFT">清单标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">标准食材标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">汇总口径单位</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">另有未知需求</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">已知需求小计</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">库存量状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">核对库存定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">差额状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">采购差额定点值</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR><TR><TD ALIGN="LEFT">采购自述状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">准备自述状态</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT">所用库存身份</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">所用库存修订</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">外键 可空</FONT></TD></TR><TR><TD ALIGN="LEFT">人工调整原因</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">可空</FONT></TD></TR></TABLE>>];
preparation_sources [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#dce9df"><B>清单需求来源</B></TD></TR><TR><TD ALIGN="LEFT">清单条目标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR><TR><TD ALIGN="LEFT">食材需求标识</TD><TD ALIGN="LEFT"><FONT COLOR="#657269">主键 外键 </FONT></TD></TR></TABLE>>];
plan_heads -> plan_revisions [label="当前版本引用", arrowhead=vee];
plan_revisions -> plan_heads [label="引用", arrowhead=vee];
planned_meals -> plan_revisions [label="引用", arrowhead=vee];
planned_foods -> planned_meals [label="引用", arrowhead=vee];
ingredient_requirements -> planned_foods [label="引用", arrowhead=vee];
ingredient_requirements -> ingredients [label="引用", arrowhead=vee];
slot_assignments -> planned_meals [label="引用", arrowhead=vee];
inventory_heads -> ingredients [label="引用", arrowhead=vee];
inventory_heads -> inventory_revisions [label="当前版本引用", arrowhead=vee];
inventory_revisions -> inventory_heads [label="引用", arrowhead=vee];
preparation_lists -> plan_revisions [label="引用", arrowhead=vee];
preparation_lines -> preparation_lists [label="引用", arrowhead=vee];
preparation_lines -> ingredients [label="引用", arrowhead=vee];
preparation_lines -> inventory_revisions [label="可空引用", arrowhead=vee];
