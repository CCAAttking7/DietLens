direction TB
class ProfileVersion["确认档案"] {
  确认目标及硬约束
  授权与可选校准
}
class PreferenceRule["稳定偏好"] {
  适用范围与状态
}
class FoodRecord["食品来源记录"] {
  食品身份及来源
  获取时间
}
class FieldEvidence["字段证据"] {
  值与单位
  状态及来源
}
