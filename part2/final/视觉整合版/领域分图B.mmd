  用途与约束版本
  安全价格营养分别判断
}
class ContextSnapshot["情境快照"] {
  餐次障碍及档案版本
}
class Action["正式行动"] {
  正式决定及执行
  实际执行时间
}
class Task["任务"] {
  类型与恢复位置
}
class CandidateDecisionEvent["候选选择事件"] {
  候选标识与情境
  事件及规则版本
}
class Review["阶段回顾"] {
  期间覆盖与反馈
}
  ProfileVersion "1" o-- "*" PreferenceRule : 确认规则
  FoodRecord "1" *-- "*" FieldEvidence : 来源字段
