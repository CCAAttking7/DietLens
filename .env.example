DIETLENS_DB=dietlens.db
DIETLENS_LOG_LEVEL=INFO

# Used only with cli.py --model; fill in a local .env or shell environment.
DIETLENS_API_KEY=
DIETLENS_MODEL_BASE_URL=https://api.openai.com/v1
DIETLENS_MODEL=
DIETLENS_MODEL_TIMEOUT=10
DIETLENS_MODEL_JSON_MODE=true

# Optional per-app DNS override for campus/VPN; retains original hostname TLS validation.
DIETLENS_MODEL_RESOLVE_IP=

# Optional task-specific text model IDs; blank means use DIETLENS_MODEL.
DIETLENS_MODEL_CONTEXT=
DIETLENS_MODEL_FOOD=
DIETLENS_MODEL_PLAN=
DIETLENS_MODEL_REVIEW=

# Optional response_format overrides per task; true/false, blank inherits global setting.
DIETLENS_MODEL_CONTEXT_JSON_MODE=
DIETLENS_MODEL_FOOD_JSON_MODE=
DIETLENS_MODEL_PLAN_JSON_MODE=
DIETLENS_MODEL_REVIEW_JSON_MODE=

# Hosted backend (optional until a Supabase project is created)
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# `demo` keeps the local user_id workflow; `supabase` verifies Bearer tokens via Auth.
DIETLENS_AUTH_MODE=demo
